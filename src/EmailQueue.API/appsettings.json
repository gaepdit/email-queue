{
  "ConnectionStrings": {
    "SqliteConnection": "Data Source=EmailQueue.db",
    "SqlServerConnection": "Server=(localdb)\\mssqllocaldb;Database=email-queue-temp;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "UseSqlServer": false,
  "AzureKeyVaultName": "",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EmailQueueSettings": {
    "ProcessingDelaySeconds": 5
  },
  "EmailServiceSettings": {
    "EnableEmail": true,
    "SmtpHost": "localhost",
    "SmtpPort": 25,
    "SecureSocketOption": "None",
    "DefaultSenderEmail": "Default.Emailer@email.invalid",
    "EnableEmailAuditing": false,
    "AuditEmailRecipients": [
      "Audit.Recipient@email.invalid"
    ]
  },
  "ApiClients": [
    {
      "ClientName": "localhost",
      "ClientId": "00000000-0000-0000-0000-100000000000",
      "ApiKey": "localhost-api-key-1"
    },
    {
      "ClientName": "Sample Client Application",
      "ClientId": "00000000-0000-0000-0000-200000000000",
      "ApiKey": "client-api-key-1"
    }
  ]
}
